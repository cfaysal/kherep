#!/bin/sh
# Runtime-independent commit policy for repositories under KHEREP_WORKSPACE.
MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

# OP-1426. The installer persists the policy in commit-policy next to this hook,
# so the rule binds every runtime, not only a process carrying KHEREP_*. Lines
# are key=value, read literally (never evaluated). A non-empty environment
# variable always wins. A malformed file is ignored with a warning: it must
# never block every commit on the host.
P_WORKSPACE='' P_REQUIRED='' P_PATTERN=''
read_policy() {
  CR=$(printf '\r')
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%"$CR"}
    case "$line" in ''|'#'*) continue ;; *=*) ;; *) return 1 ;; esac
    value=${line#*=}
    case "${line%%=*}" in
      workspace) P_WORKSPACE=$value ;;
      work_item_required) case "$value" in 0|1) P_REQUIRED=$value ;; *) return 1 ;; esac ;;
      work_item_pattern) P_PATTERN=$value ;;
      *) return 1 ;;
    esac
  done < "$1"
}
POLICY_FILE="$(dirname "$0")/commit-policy"
if [ -f "$POLICY_FILE" ] && ! read_policy "$POLICY_FILE"; then
  printf '\nKherep commit policy ignored a malformed policy file: %s\n' "$POLICY_FILE" >&2
  P_WORKSPACE='' P_REQUIRED='' P_PATTERN=''
fi
ENV_REQUIRED=$KHEREP_WORK_ITEM_REQUIRED
KHEREP_WORKSPACE=${KHEREP_WORKSPACE:-$P_WORKSPACE}
KHEREP_WORK_ITEM_REQUIRED=${KHEREP_WORK_ITEM_REQUIRED:-$P_REQUIRED}
KHEREP_WORK_ITEM_PATTERN=${KHEREP_WORK_ITEM_PATTERN:-$P_PATTERN}
[ -n "$KHEREP_WORKSPACE" ] || exit 0

TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null) || TOPLEVEL=$(pwd)
canonical_dir() {
  KHEREP_PATH=$(printf '%s' "$1" | tr '\\' '/')
  (CDPATH=; export CDPATH; cd -P "$KHEREP_PATH" && pwd -P) 2>/dev/null
}
TOP_REAL=$(canonical_dir "$TOPLEVEL") || {
  printf '\nKherep commit policy could not resolve the repository directory.\n' >&2
  exit 1
}
WORK_REAL=$(canonical_dir "$KHEREP_WORKSPACE") || {
  printf '\nKherep commit policy could not resolve KHEREP_WORKSPACE. Check the configured directory.\n' >&2
  exit 1
}
TOP_LC=$(printf '%s' "$TOP_REAL" | tr 'A-Z' 'a-z')
WORK_LC=$(printf '%s' "$WORK_REAL" | tr 'A-Z' 'a-z' | sed 's|/*$||')
case "$TOP_LC" in "$WORK_LC"|"$WORK_LC"/*) ;; *) exit 0 ;; esac

if grep -v '^#' "$MSG_FILE" | grep -Eqi '^[[:space:]]*co-authored-by:|generated with \[claude code\]'; then
  printf '\nKherep commit policy rejected an AI attribution trailer. Remove it and commit again.\n' >&2
  exit 1
fi

# Per-repository opt-out: `git config --local kherep.workItemRequired false`.
# Precedence: a non-empty KHEREP_WORK_ITEM_REQUIRED, then this repository-local
# value, then the policy file. Git parses the value as a boolean; an absent,
# unreadable or invalid value is not an opt-out.
if [ -z "$ENV_REQUIRED" ] &&
  [ "$(git config --local --type=bool --get kherep.workItemRequired 2>/dev/null)" = "false" ]; then
  exit 0
fi

[ "$KHEREP_WORK_ITEM_REQUIRED" = "1" ] || exit 0
[ "$KHEREP_WORK_ITEM" = "none" ] && exit 0
SUBJECT=$(grep -v '^#' "$MSG_FILE" | sed '/^[[:space:]]*$/d' | head -n 1)
case "$SUBJECT" in "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;; esac

PATTERN=${KHEREP_WORK_ITEM_PATTERN:-'[A-Z][A-Z0-9]{1,9}-[0-9]+'}
if printf '%s' "$SUBJECT" | grep -Eq "^(${PATTERN})[[:space:]]+[^[:space:]]"; then
  exit 0
fi
printf '\nKherep commit policy requires the subject to start with the configured work-item key and a space.\n' >&2
exit 1
