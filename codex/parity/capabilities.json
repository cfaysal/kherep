    },
    "dc-plugin-build-runner": {
      "model": "gpt-5.6-terra",
      "reasoning": "medium"
    },
    "forge-deploy-validator": {
      "model": "gpt-5.6-terra",
      "reasoning": "medium",
      "sandbox": "read-only"
    },
    "lmstudio-mac-researcher": {
      "model": "gpt-5.6-terra",
      "reasoning": "low",
      "sandbox": "read-only"
    },
    "lmstudio-win-researcher": {
      "model": "gpt-5.6-terra",
      "reasoning": "low",
      "sandbox": "read-only"
    },
