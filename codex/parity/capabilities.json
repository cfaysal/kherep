      "model": "gpt-5.6-terra",
      "reasoning": "low",
      "sandbox": "read-only"
    },
    "n8n-workflow-deploy-runner": {
      "model": "gpt-5.6-sol",
      "reasoning": "high"
    },
    "win-agent": {
      "model": "gpt-5.6-terra",
      "reasoning": "low",
      "sandbox": "read-only"
