{
  "schemaVersion": 1,
  "canonicalTargetPolicy": {
    "mode": "replace-with-backup",
    "scope": [
      "kherepSkills",
      "commands",
      "agents"
    ]
  },
  "preToolUseRuntime": {
    "status": "unverified",
    "affectedTool": "functions.exec",
    "verification": "behavioral-probe-on-target",
    "configPresenceSufficient": false
  },
  "workItemPolicy": {
    "status": "configurable",
    "requiredEnv": "KHEREP_WORK_ITEM_REQUIRED",
    "workspaceEnv": "KHEREP_WORKSPACE",
    "patternEnv": "KHEREP_WORK_ITEM_PATTERN",
    "enforcement": "commit-msg-hook",
    "documentationChangesIncluded": true
  },
  "kherepSkills": {
    "active": [
      "kherep-content-humanizer",
      "kherep-deploy-workflow",
      "kherep-grill",
      "kherep-linkedin-draft",
      "kherep",
      "kherep-twg",
      "codebase-design",
      "codebase-memory",
      "domain-modeling",
      "forge-bulk-op-pattern",
      "improve-codebase-architecture",
      "local-inference",
      "vite-base-forge"
    ],
    "compatibility": []
  },
  "commands": [
    "btw",
    "kickoff",
    "memo-checkpoint",
    "memo-eod",
    "memo-resume",
    "memo-retro"
  ],
  "agents": {
    "kherep-builder": {
      "model": "gpt-5.6-sol",
